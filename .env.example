# ============================================================================
# MORUNGGIG (SKILLBRIDGE NL) — ENVIRONMENT CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 1. NEON POSTGRESQL EXTERNAL DATABASE URL
# Paste your Neon connection string below (e.g. postgresql://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require)
# You can also set or update this live from the "Cloud & OAuth Setup" button in the top navigation bar!
# When empty, MorungGig automatically uses its built-in persistent local ACID store (data/morunggig_store.json).
# ----------------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 CREDENTIALS
# Paste your Google Cloud Console OAuth 2.0 Client ID and Client Secret below.
# You can also configure these live from the "Cloud & OAuth Setup" modal in the UI!
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ----------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC & SECURITY SECRETS (Zero-Raw-PII & Nodal Webhook HMAC)
# ----------------------------------------------------------------------------
MG_SALT_2026=MG_SALT_2026_NAGALAND_CAMPUS_EXCHANGE
JWT_SECRET=mg_nl_2026_stateless_jwt_secret_key_994821048
WEBHOOK_HMAC_SECRET=mg_nl_2026_razorpay_nodal_webhook_hmac_secret
